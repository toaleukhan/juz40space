# CustDev: транскриптті протоколға айналдыратын Gemini кілті. Тегін —
# https://aistudio.google.com/apikey. Қойылмаса, /api/custdev/sessions/:id/generate
# 503 қайтарады, бірақ раунд/сұхбат жасау, транскрипт жазу, қолмен өңдеу бәрі жұмыс істейді.
GEMINI_API_KEY=
# Әдепкі — gemini-3.6-flash. Модель ескірсе/ауыссса осымен алмастырасың
# (Railway-де осыны қойсаң, кодты өзгертудің қажеті жоқ).
GEMINI_MODEL=
